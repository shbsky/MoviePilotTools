{
  // 这是脱敏模板：复制为 build-profile.json5 后填入自己的签名材料。
  // 真实的 build-profile.json5 已在 .gitignore 中，不会进仓库（内含本机绝对路径与签名口令）。
  // 签名材料获取：DevEco Studio → File → Project Structure → Signing Configs → 自动生成。
  app: {
    signingConfigs: [
      {
        name: 'default',
        type: 'HarmonyOS',
        material: {
          certpath: './signing/default.cer',
          keyAlias: 'debugKey',
          keyPassword: '<FILL_IN>',
          profile: './signing/default.p7b',
          signAlg: 'SHA256withECDSA',
          storeFile: './signing/default.p12',
          storePassword: '<FILL_IN>',
        },
      },
    ],
    products: [
      {
        name: 'default',
        signingConfig: 'default',
        targetSdkVersion: '26.0.0',
        compatibleSdkVersion: '26.0.0',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}
